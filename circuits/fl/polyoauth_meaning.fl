/// Spec: specs/POLYOAUTH_CE_APP_GRAPH_SPEC.md
/// PolyOAuth CE Meaning Domains — 3 meaning domains, 1 noise filter,
/// 2 SME panels for the PolyOAuth cognitive integration.
///
/// Epic: polyoauth#TBD (CE + App Graph Integration)
/// govern lex polylabs/polyoauth/cognitive

lex polylabs/polyoauth/cognitive

@target software
@codegen_targets ["wasm", "rust"]

import "polykit/circuits/fl/polykit_cognitive.fl" {
    ProductMeaningDomain, MeaningIngestion, DomainId, MeaningId,
    ObservationHash, NoiseFilterId, SmePanelId,
    register_meaning_domain,
}

// ── Types ──────────────────────────────────────────────────────────────────────

type AuthSignal = bytes(64)
type ThresholdConfig = bytes(32)

// ── Domain Data ─────────────────────────────────────────────────────────────────

data AuthPatternsDomain : polyoauth/cognitive v1 {
    domain_id: DomainId,
    login_latency_window_ms: u64,
    risk_score_spike_sigma: u8,
    credential_rotation_max_age_days: u16,
    step_up_trigger_threshold_bps: u16,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write; on_anomaly alert "oauth-security" }

data SessionHealthDomain : polyoauth/cognitive v1 {
    domain_id: DomainId,
    session_idle_timeout_ms: u64,
    concurrent_session_limit: u16,
    premature_expiry_rate_ceiling_bps: u16,
    token_refresh_to_access_ratio_floor_bps: u16,
    token_reuse_detection_enabled: bool,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write; on_anomaly alert "oauth-security" }

data FederationCoverageDomain : polyoauth/cognitive v1 {
    domain_id: DomainId,
    provider_failure_rate_ceiling_bps: u16,
    discovery_endpoint_timeout_ms: u64,
    webauthn_adoption_target_bps: u16,
    token_exchange_success_floor_bps: u16,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write; on_anomaly alert "oauth-team" }

// ── Noise Filter ────────────────────────────────────────────────────────────────

data OAuthNoiseFilterConfig : polyoauth/cognitive v1 {
    filter_id: NoiseFilterId,
    suppress_token_refresh_cycles: bool,
    suppress_session_keepalives: bool,
    suppress_oidc_discovery_refetch: bool,
    suppress_cors_preflight: bool,
    keepalive_dedup_window_ms: u64,
    min_signal_confidence: u8,
    dedup_window_ms: u64,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write }

// ── SME Panels ──────────────────────────────────────────────────────────────────

data IdentitySecurityPosturePanel : polyoauth/cognitive v1 {
    panel_id: SmePanelId,
    domain_scope: bytes(64),
    min_panelists: u8,
    specializations: list<bytes(32)>,
    calibration_accuracy_floor_bps: u16,
    review_timeout_ms: u64,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write; on_anomaly alert "oauth-security" }

data FederationHealthPanel : polyoauth/cognitive v1 {
    panel_id: SmePanelId,
    domain_scope: bytes(64),
    min_panelists: u8,
    specializations: list<bytes(32)>,
    calibration_accuracy_floor_bps: u16,
    review_timeout_ms: u64,
}   store kv  govern lex polylabs/polyoauth/cognitive
    cortex { infer on_write; on_anomaly alert "oauth-ops" }

// ── Streams & Series ────────────────────────────────────────────────────────────

stream auth_patterns_obs:        event<MeaningIngestion> { retention 90d;  consumers [streamsight, cortex] }
stream session_health_obs:       event<MeaningIngestion> { retention 365d; consumers [streamsight, cortex, audit_trail] }
stream federation_coverage_obs:  event<MeaningIngestion> { retention 90d;  consumers [streamsight, cortex] }

series polyoauth_cognitive_series {
    over AuthPatternsDomain,
    fields: [login_latency_p50, login_latency_p99, risk_score_p95,
             session_duration_p50, idle_ratio, concurrent_sessions,
             provider_success_rate, token_exchange_volume, webauthn_adoption_rate]
}

extern {
    fn store_get(table: string, key: bytes) -> bytes
    fn store_put(table: string, key: bytes, value: bytes) -> bool
    fn emit(stream: string, event: bytes) -> bool
}

// ── Domain Registration Circuits ────────────────────────────────────────────────

circuit register_auth_patterns_domain() -> ProductMeaningDomain
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin, operator]  observe metrics: [domains_registered]
    meters [compute_cycles, memory_bytes, storage]
    wasm_abi [store_get, store_put, emit, now]
    test golden "register_auth_patterns" {
        let r = register_auth_patterns_domain()
        assert len(r.domain_id) == 32
        assert r.crystallization_threshold == 75
    }
{ register_meaning_domain(bytes(128, "polylabs/polyoauth"), bytes(64, "identity/auth_patterns"),
    bytes(256, "Login frequency distribution, risk score trends, credential rotation health"), 75, 80) }

circuit register_session_health_domain() -> ProductMeaningDomain
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin, operator]  observe metrics: [domains_registered]
    meters [compute_cycles, memory_bytes, storage]
    wasm_abi [store_get, store_put, emit, now]
    test golden "register_session_health" {
        let r = register_session_health_domain()
        assert len(r.domain_id) == 32
        assert r.crystallization_threshold == 80
    }
{ register_meaning_domain(bytes(128, "polylabs/polyoauth"), bytes(64, "identity/session_health"),
    bytes(256, "Session duration distribution, timeout pattern anomalies, token refresh cadence"), 80, 90) }

circuit register_federation_coverage_domain() -> ProductMeaningDomain
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin, operator]  observe metrics: [domains_registered]
    meters [compute_cycles, memory_bytes, storage]
    wasm_abi [store_get, store_put, emit, now]
    test golden "register_federation_coverage" {
        let r = register_federation_coverage_domain()
        assert len(r.domain_id) == 32
        assert r.crystallization_threshold == 65
    }
{ register_meaning_domain(bytes(128, "polylabs/polyoauth"), bytes(64, "identity/federation_coverage"),
    bytes(256, "Provider usage distribution, token exchange volume, WebAuthn adoption rates"), 65, 60) }

// ── Noise Filter Setup ──────────────────────────────────────────────────────────

circuit configure_oauth_noise_filter() -> OAuthNoiseFilterConfig
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin]  observe metrics: [noise_filters_configured]
    meters [compute_cycles, storage]  wasm_abi [store_get, store_put, emit, now]
    test golden "configure_noise_filter" {
        let r = configure_oauth_noise_filter()
        assert r.suppress_token_refresh_cycles == true
        assert r.suppress_session_keepalives == true
        assert r.suppress_oidc_discovery_refetch == true
        assert r.min_signal_confidence == 60
    }
{
    let fid = sha3_256(bytes(32, "polylabs/noise/polyoauth"))
    let cfg = OAuthNoiseFilterConfig {
        filter_id: fid,
        suppress_token_refresh_cycles: true,
        suppress_session_keepalives: true,
        suppress_oidc_discovery_refetch: true,
        suppress_cors_preflight: true,
        keepalive_dedup_window_ms: 15000,
        min_signal_confidence: 60,
        dedup_window_ms: 500,
    }
    store_put("cognitive_noise_filters", fid, encode(cfg))
    cfg
}

// ── SME Panel Setup ─────────────────────────────────────────────────────────────

circuit configure_identity_security_posture_panel() -> IdentitySecurityPosturePanel
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin]  observe metrics: [sme_panels_configured]
    meters [compute_cycles, storage]  wasm_abi [store_get, store_put, emit, now]
    test golden "configure_identity_security_panel" {
        let r = configure_identity_security_posture_panel()
        assert r.min_panelists == 3
        assert r.calibration_accuracy_floor_bps >= 7000
    }
{
    let pid = sha3_256(bytes(32, "polylabs/sme/polyoauth_identity"))
    let p = IdentitySecurityPosturePanel {
        panel_id: pid,
        domain_scope: bytes(64, "identity/auth_patterns"),
        min_panelists: 3,
        specializations: [bytes(32, "biometric_auth"), bytes(32, "risk_scoring"),
            bytes(32, "session_management"), bytes(32, "credential_lifecycle")],
        calibration_accuracy_floor_bps: 8000,
        review_timeout_ms: 86400000,
    }
    store_put("cognitive_sme_panels", pid, encode(p))
    p
}

circuit configure_federation_health_panel() -> FederationHealthPanel
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin]  observe metrics: [sme_panels_configured]
    meters [compute_cycles, storage]  wasm_abi [store_get, store_put, emit, now]
    test golden "configure_federation_panel" {
        let r = configure_federation_health_panel()
        assert r.min_panelists == 3
        assert r.calibration_accuracy_floor_bps >= 7000
    }
{
    let pid = sha3_256(bytes(32, "polylabs/sme/polyoauth_federation"))
    let p = FederationHealthPanel {
        panel_id: pid,
        domain_scope: bytes(64, "identity/federation_coverage"),
        min_panelists: 3,
        specializations: [bytes(32, "oidc_protocol"), bytes(32, "token_exchange"),
            bytes(32, "provider_integration"), bytes(32, "webauthn_ceremony")],
        calibration_accuracy_floor_bps: 7500,
        review_timeout_ms: 43200000,
    }
    store_put("cognitive_sme_panels", pid, encode(p))
    p
}

// ── CE Orchestrator ─────────────────────────────────────────────────────────────

circuit polyoauth_register_ce(product_lex: string) -> bool
    profile poly_framework_standard  lex polylabs/polyoauth/cognitive  precision B
    rbac [admin]  observe metrics: [ce_registrations]
    meters [compute_cycles, memory_bytes, storage]
    wasm_abi [store_get, store_put, emit, now]
{
    let d1 = register_auth_patterns_domain()
    let d2 = register_session_health_domain()
    let d3 = register_federation_coverage_domain()
    let nf = configure_oauth_noise_filter()
    let p1 = configure_identity_security_posture_panel()
    let p2 = configure_federation_health_panel()

    len(d1.domain_id) == 32 and len(d2.domain_id) == 32 and len(d3.domain_id) == 32
        and nf.suppress_token_refresh_cycles == true
        and p1.min_panelists >= 3 and p2.min_panelists >= 3
}

// ── Integration Test ────────────────────────────────────────────────────────────

test golden "full_ce_pipeline_setup" {
    exec {
        let result = polyoauth_register_ce("polylabs/polyoauth")
    }
    assert {
        result == true
    }
}

test golden "all_domains_register_independently" {
    exec {
        let ap = register_auth_patterns_domain()
        let sh = register_session_health_domain()
        let fc = register_federation_coverage_domain()
    }
    assert {
        len(ap.domain_id) == 32; ap.crystallization_threshold == 75
        len(sh.domain_id) == 32; sh.crystallization_threshold == 80
        len(fc.domain_id) == 32; fc.crystallization_threshold == 65
    }
}

test golden "noise_filter_suppresses_lifecycle_events" {
    exec {
        let nf = configure_oauth_noise_filter()
    }
    assert {
        nf.suppress_token_refresh_cycles == true
        nf.suppress_session_keepalives == true
        nf.suppress_oidc_discovery_refetch == true
        nf.suppress_cors_preflight == true
        nf.keepalive_dedup_window_ms == 15000
        nf.dedup_window_ms == 500
    }
}
