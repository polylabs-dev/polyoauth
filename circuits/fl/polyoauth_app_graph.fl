// ═══════════════════════════════════════════════════════════════════════════════
// Graph Registration
// ═══════════════════════════════════════════════════════════════════════════════

/// Register all 12 PolyOAuth modules and their intra-graph REQUIRES
/// dependency edges into the provided CsrStorage graph.
circuit polyoauth_app_graph_register(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polyoauth
    @status production
    @precision B
    @attested true
    invariant "capacity" { graph.num_nodes + POLYOAUTH_MODULE_COUNT as u32 <= 4096 }
    observe metrics: [registered_module_count, registered_edge_count]
    meters [compute_cycles, memory_bytes]
{
    // ── Add all 12 modules ──────────────────────────────────────────────────
    let (g, id_auth)            = module_graph_add_module(graph, polyoauth_auth_module())
    let (g, id_token)           = module_graph_add_module(g, polyoauth_token_module())
    let (g, id_session)         = module_graph_add_module(g, polyoauth_session_module())
    let (g, id_oidc)            = module_graph_add_module(g, polyoauth_oidc_module())
    let (g, id_webauthn)        = module_graph_add_module(g, polyoauth_webauthn_module())
    let (g, id_risk)            = module_graph_add_module(g, polyoauth_risk_module())
    let (g, id_admin)           = module_graph_add_module(g, polyoauth_admin_module())
    let (g, id_metering)        = module_graph_add_module(g, polyoauth_metering_module())
    let (g, id_platform_health) = module_graph_add_module(g, polyoauth_platform_health_module())
    let (g, id_rbac)            = module_graph_add_module(g, polyoauth_rbac_module())
    let (g, id_identity_graph)  = module_graph_add_module(g, polyoauth_identity_graph_module())
    let (g, id_token_dag)       = module_graph_add_module(g, polyoauth_token_dag_module())

    let vc = ">=" ++ POLYOAUTH_VERSION_STR

    // ── Intra-graph REQUIRES edges ──────────────────────────────────────────
    // auth -> session (session creation on successful auth)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_auth",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_session",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_auth, id_session)

    // auth -> risk (risk evaluation before granting access)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_auth",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_risk",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_auth, id_risk)

    // auth -> webauthn (biometric credential verification)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_auth",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_webauthn",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_auth, id_webauthn)

    // token -> session (token bound to session lifecycle)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_token",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_session",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_token, id_session)

    // token -> token_dag (token lineage tracking)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_token",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_token_dag",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_token, id_token_dag)

    // oidc -> token (ID token issuance after OIDC flow)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_oidc",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_token",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_oidc, id_token)

    // oidc -> identity_graph (federated identity resolution)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_oidc",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_identity_graph",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_oidc, id_identity_graph)

    // risk -> rbac (policy-gated risk score enforcement)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_risk",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_rbac",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_risk, id_rbac)

    // admin -> rbac (admin operations require RBAC check)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_admin",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_rbac",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_admin, id_rbac)

    // metering -> token (token issuance accounting)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_metering",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_token",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_metering, id_token)

    // platform_health -> session (session health overlay reads)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polyoauth_platform_health",
        source_version: POLYOAUTH_VERSION_STR, target_module: "polyoauth_session",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_platform_health, id_session)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cross-Graph Bridge Edges — PolyPass, PolyAuthenticator, SSO Consumer
// ═══════════════════════════════════════════════════════════════════════════════

/// Register EDGE_BRIDGE_TO edges linking PolyOAuth's auth module to PolyPass
/// credential vault, webauthn module to PolyAuthenticator ceremony, and OIDC
/// module to the PolyKit SSO consumer for cross-product single sign-on.
circuit polyoauth_register_bridge_edges(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polyoauth
    @status production
    @precision B
    @attested true
    observe metrics: [bridge_count]
    meters [compute_cycles]
{
    let auth_id = find_poly_module_id(graph, "polyoauth_auth")
    let webauthn_id = find_poly_module_id(graph, "polyoauth_webauthn")
    let oidc_id = find_poly_module_id(graph, "polyoauth_oidc")

    let g = graph

    // polyoauth_auth -> PolyPass credential vault bridge
    if auth_id != 0xFFFFFFFF as u32 {
        let pass_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYOAUTH_APP_LEX,
            source_module: "polyoauth_auth",
            target_lex: "polylabs/polypass",
            target_module: "polypass_vault",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["credential_ref", "rotation_policy", "breach_status"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, pass_bridge, auth_id)
    }

    // polyoauth_webauthn -> PolyAuthenticator ceremony bridge
    if webauthn_id != 0xFFFFFFFF as u32 {
        let authn_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYOAUTH_APP_LEX,
            source_module: "polyoauth_webauthn",
            target_lex: "polylabs/polyauthenticator",
            target_module: "polyauth_ceremony",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["attestation_format", "credential_id", "challenge_response"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, authn_bridge, webauthn_id)
    }

    // polyoauth_oidc -> PolyKit SSO consumer bridge (all products)
    if oidc_id != 0xFFFFFFFF as u32 {
        let sso_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYOAUTH_APP_LEX,
            source_module: "polyoauth_oidc",
            target_lex: "polylabs/polykit",
            target_module: "polykit_sso_consumer",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["id_token", "session_handle", "scope_grants"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, sso_bridge, oidc_id)
    }

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Internal Helpers
// ═══════════════════════════════════════════════════════════════════════════════

circuit find_polyoauth_module_id(graph: CsrStorage, name: string) -> u32
    lex polylabs/polyoauth
    @status production
    @precision D
{
    find_poly_module_id(graph, name)
}

// ── Metrics Store ──────────────────────────────────────────────────────────────

store series polyoauth_app_graph_metrics
    lex polylabs/polyoauth/metrics
{
    operation: string key
    product_name: string
    module_count: u32
    edge_count: u32
    bridge_count: u32
    register_latency_ns: u64
}

// ── Golden Tests ───────────────────────────────────────────────────────────────

test golden "polyoauth_app_graph_registers_12_modules" {
    exec {
        let g = graph_create()
        let g = polyoauth_app_graph_register(g)
    }
    assert {
        g.num_nodes == 12
        g.num_edges == 11
        find_poly_module_id(g, "polyoauth_auth") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_token") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_session") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_oidc") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_webauthn") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_risk") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_admin") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_metering") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_platform_health") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_rbac") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_identity_graph") != 0xFFFFFFFF
        find_poly_module_id(g, "polyoauth_token_dag") != 0xFFFFFFFF
    }
}

test golden "polyoauth_bridge_edges_connect_cross_product" {
    exec {
        let g = graph_create()
        let g = polyoauth_app_graph_register(g)
        let g = polyoauth_register_bridge_edges(g)
    }
    assert {
        g.num_nodes == 12 + 3
        let auth_id = find_poly_module_id(g, "polyoauth_auth")
        auth_id != 0xFFFFFFFF
        let webauthn_id = find_poly_module_id(g, "polyoauth_webauthn")
        webauthn_id != 0xFFFFFFFF
        let oidc_id = find_poly_module_id(g, "polyoauth_oidc")
        oidc_id != 0xFFFFFFFF
    }
}

test golden "make_polyoauth_module_creates_valid_node" {
    let node = make_polyoauth_module("polyoauth_test",
        AperturePartition::Backend as u8,
        SLATier::Standard as u8,
        ResourceBudget8D {
            execution: 5000, hash_ops: 200, bandwidth: 2000,
            storage: 1000, observe_events: 100, proofs: 10,
            consensus: 5, memory: 4096,
        })
    assert node.name == "polyoauth_test"
    assert node.version_major == POLYOAUTH_VERSION_MAJOR
    assert node.version_minor == POLYOAUTH_VERSION_MINOR
    assert node.resource_budget.execution == 5000
    assert node.state == ModuleState::Active as u8
    assert node.sla_tier == SLATier::Standard as u8
}

// ── Extern ─────────────────────────────────────────────────────────────────────

extern "rust" {
    #[module = "estream_runtime"]
    #[api = "graph"]
    #[state = "os"]
    fn graph_create() -> CsrStorage
}
