/// Spec: specs/POLYOAUTH_CE_APP_GRAPH_SPEC.md
/// App Graph for Poly OAuth — 12 ModuleNode definitions composing the
/// PQ biometric SSO product into Backend and Shared partitions. Registers
/// intra-graph REQUIRES edges, cross-product bridge edges (PolyPass,
/// PolyAuthenticator, SSO consumer), and CE meaning/noise/SME edges.
///
/// Epic: polyoauth#TBD (CE + App Graph Integration)
/// govern lex polylabs/polyoauth

lex polylabs/polyoauth

@target software
@codegen_targets ["wasm", "rust"]

import "core/deployment/module_stratum.fl" {
    ModuleNode, ModuleEdge, InterAppEdge, CsrStorage,
    CompilationReceipt, ResourceBudget8D, SemVer,
    ModuleType, AperturePartition, ModuleState, RolloutState,
    PersistencePolicy, OfflineCachePolicy, SLATier, EntitlementTier,
    EnforcementMode, BridgeScope,
    module_graph_add_module, module_graph_add_edge,
    module_graph_add_bridge_edge,
    EDGE_REQUIRES, EDGE_BRIDGE_TO,
}

import "polykit/circuits/fl/polykit_app_graph.fl" {
    ProductGraphConfig, make_poly_module, add_poly_module,
    add_poly_edge, add_poly_bridge_edge, add_poly_ce_edges,
    find_poly_module_id,
    EDGE_TYPE_REQUIRES, EDGE_TYPE_BRIDGE_TO,
    EDGE_MEANING_SUPPORTS, EDGE_MEANING_ENRICHES,
    EDGE_CONCEPT_ORGANIZES, EDGE_EXPERT_JUDGES,
}

// ── Constants ──────────────────────────────────────────────────────────────────

const POLYOAUTH_VERSION_MAJOR: u32 = 0
const POLYOAUTH_VERSION_MINOR: u32 = 12
const POLYOAUTH_VERSION_PATCH: u32 = 0
const POLYOAUTH_APP_LEX: string = "polylabs/polyoauth"
const POLYOAUTH_VERSION_STR: string = "0.12.0"
const POLYOAUTH_MODULE_COUNT: u64 = 12

// ── Product Config ─────────────────────────────────────────────────────────────

circuit polyoauth_product_config() -> ProductGraphConfig
    lex polylabs/polyoauth
    @status production
    @precision D
{
    ProductGraphConfig {
        product_name: "polyoauth",
        product_lex: POLYOAUTH_APP_LEX,
        version_major: POLYOAUTH_VERSION_MAJOR,
        version_minor: POLYOAUTH_VERSION_MINOR,
        version_patch: POLYOAUTH_VERSION_PATCH,
        module_count: POLYOAUTH_MODULE_COUNT as u32,
        entitlement_tier: EntitlementTier::Free as u8,
        sla_tier: SLATier::Premium as u8,
    }
}

// ── Helpers ────────────────────────────────────────────────────────────────────

circuit make_polyoauth_module(
    name: string,
    partition: u8,
    sla: u8,
    budget: ResourceBudget8D
) -> ModuleNode
    lex polylabs/polyoauth
    @status production
    @precision C
    observe metrics: [module_name, aperture_partition]
    meters [compute_cycles]
{
    let cfg = polyoauth_product_config()
    let ver = SemVer {
        major: POLYOAUTH_VERSION_MAJOR,
        minor: POLYOAUTH_VERSION_MINOR,
        patch: POLYOAUTH_VERSION_PATCH,
        pre_release: "",
    }
    let receipt = CompilationReceipt {
        source_hash: bytes(32, 0x00),
        compiler_version: ver,
        output_hash: bytes(32, 0x00),
        prime_device_id: None,
        compilation_timestamp: 0,
        reproducible_verified: false,
        receipt_signature: bytes(4627, 0x00),
    }

    ModuleNode {
        name: name,
        version_major: POLYOAUTH_VERSION_MAJOR,
        version_minor: POLYOAUTH_VERSION_MINOR,
        version_patch: POLYOAUTH_VERSION_PATCH,
        version_pre: "",
        module_type: ModuleType::SmartCircuit as u8,
        content_hash: bytes(32, 0x00),
        signature_chain: bytes(0),
        aperture_partition: partition,
        role_set: ["User", "Admin", "IdPAdmin"],
        required_entitlement: EntitlementTier::Free as u8,
        classification_domains: [],
        max_classification_level: 0,
        compilation_receipt: receipt,
        source_hash: bytes(32, 0x00),
        compiler_version_major: POLYOAUTH_VERSION_MAJOR,
        compiler_version_minor: POLYOAUTH_VERSION_MINOR,
        prime_device_id: bytes(0),
        reproducible_verified: false,
        resource_budget: budget,
        budget_enforcement_mode: EnforcementMode::Hard as u8,
        state: ModuleState::Active as u8,
        rollout_state: RolloutState::Canary as u8,
        canary_target: None,
        persistence: PersistencePolicy::Persistent as u8,
        offline_cache_policy: OfflineCachePolicy::CacheAndVerify as u8,
        max_staleness_seconds: 1800,
        sla_tier: sla,
        preferred_locality: "edge",
        created_at_ms: 0,
        updated_at_ms: 0,
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Module Definitions — 12 ModuleNodes
// ═══════════════════════════════════════════════════════════════════════════════

// ── polyoauth_auth ── SPARK biometric auth, ML-DSA-87 challenge-response ─────

circuit polyoauth_auth_module() -> ModuleNode
    lex polylabs/polyoauth  @status production  @precision B
    observe metrics: [module_init]  meters [compute_cycles]
{
    make_polyoauth_module("polyoauth_auth", AperturePartition::Backend as u8,
        SLATier::Premium as u8, ResourceBudget8D {
            execution: 300000, hash_ops: 10000, bandwidth: 40000,
            storage: 50000, observe_events: 12000, proofs: 200,
            consensus: 50, memory: 67108864,
        })
}

